# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Must be an address on a domain you have verified in Resend.
# Resend's onboarding@resend.dev works for testing but only delivers to your own address.
RESEND_FROM_EMAIL=hello@yourdomain.co.uk

# Where lead notifications land. Defaults to site.contactEmail if unset.
LEAD_INBOX=dharshansubramaniyam@gmail.com

# Public site URL, used for canonical URLs and OG tags.
NEXT_PUBLIC_SITE_URL=https://d2dweb.co.uk
