# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The "from" address. This must be on a domain you have verified in Resend —
# a Gmail address cannot be used here, as Resend cannot sign mail for gmail.com.
# Use something on your own domain, e.g. hello@d2dweb.co.uk.
# For testing before your domain is verified, onboarding@resend.dev works but
# only delivers to the address that owns the Resend account.
RESEND_FROM_EMAIL=hello@yourdomain.co.uk

# Where lead notifications land. Defaults to site.contactEmail if unset.
LEAD_INBOX=direct2digitalweb@gmail.com

# Public site URL, used for canonical URLs and OG tags.
NEXT_PUBLIC_SITE_URL=https://d2dweb.co.uk
