# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Must be on a domain verified in Resend. A Gmail address cannot be used as
# the sender — Resend cannot sign mail for gmail.com.
# onboarding@resend.dev works for testing, but only delivers to the address
# that owns the Resend account.
RESEND_FROM_EMAIL=hello@yourdomain.co.uk

# Where lead notifications land. Defaults to site.contactEmail if unset.
LEAD_INBOX=direct2digitalweb@gmail.com

# ── Site ─────────────────────────────────────────────────────
# Leave UNSET rather than blank if you have no domain yet; an empty string
# used to fail the build.
NEXT_PUBLIC_SITE_URL=https://tradewebco.co.uk

# Overrides the published contact address without a code change.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@tradewebco.co.uk

# ── Database (Supabase) ──────────────────────────────────────
# Project Settings -> API Keys in the Supabase dashboard.
#
# NOTE: this is a TEMPLATE. Put real values in .env.local, which is
# gitignored — never in this file, which is committed.
#
# Supabase renamed these: the old "anon" key is now the "publishable" key,
# and the old "service_role" key is now the "secret" key. The code accepts
# either name, so older projects keep working.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Publishable key (shown openly, starts sb_publishable_).
# Safe in the browser: every query it makes runs under Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Secret key (hidden behind "Reveal", starts sb_secret_).
# BYPASSES Row Level Security entirely. Never expose it to the browser,
# never commit it, and never paste it into a chat. Server-side only.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# ── Admin ────────────────────────────────────────────────────
# The admin lives at /<ADMIN_PATH> rather than /admin, to keep it out of the
# way of bots scanning for well-known paths. This is obscurity, not security:
# the real protection is the login behind it. Use something unguessable.
ADMIN_PATH=change-me-to-something-unguessable
